# ModWrench environment configuration.
# Copy to `.env` at the workspace root and fill in the values you need.
# Every variable here is optional unless you use the specific feature.
#
# ModWrench prefers credentials in the OS keychain (set via `modwrench auth
# login <platform>`) over env vars. Use env vars for legacy API keys, OAuth
# client configuration, base-URL overrides, and workbench tuning.


# ─── Logging ─────────────────────────────────────────────────────────────────
# Minimum log level. One of: debug, info, warn, error. Default: info.
# Logs are written to stderr as JSON so they never interfere with MCP stdio
# traffic on stdout.
# LOG_LEVEL=debug


# ─── Nexus Mods ──────────────────────────────────────────────────────────────
# Legacy API key — only used as a fallback if no OAuth token is in the
# keychain. Generate one at: https://www.nexusmods.com/users/myaccount?tab=api+access
# Prefer `modwrench auth login nexus` (OAuth, PKCE) for new installs.
# NEXUS_API_KEY=

# OAuth client ID — required for `modwrench auth login nexus`. Register an
# OAuth app under your Nexus account's API Access settings and paste the
# client ID here.
# NEXUS_OAUTH_CLIENT_ID=

# OAuth client secret — only set this if your Nexus app is registered as a
# confidential client. PKCE-only public clients don't need it.
# NEXUS_OAUTH_CLIENT_SECRET=

# API base URL override. Default: https://api.nexusmods.com/v1
# NEXUS_BASE_URL=


# ─── mod.io ──────────────────────────────────────────────────────────────────
# API key — required for the OAuth email-code flow that `modwrench auth login
# modio` initiates. Generate one at: https://mod.io/me/access
# Once you've completed the email exchange, the OAuth token lives in your
# keychain and this key is only needed if you re-run auth login.
# MODIO_API_KEY=

# API base URL override. Default: https://api.mod.io/v1
# MODIO_BASE_URL=


# ─── Workbench ───────────────────────────────────────────────────────────────
# Override Steam root detection if your Steam install isn't at one of the
# standard locations. Use forward slashes on Windows.
# Examples:
#   Windows:  D:/SteamLibrary
#   Linux:    /home/you/.steam/steam
#   macOS:    /Users/you/Library/Application Support/Steam
# STEAM_ROOT=

# Which branch of the LOOT masterlist repos to fetch from GitHub.
# Default: v0.26 (current stable maintenance branch as of 2026 — community
# conflict entries continue to flow into it; the schema stays frozen until
# v0.27). Override to "master" for bleeding-edge masterlist data, or to a
# different version branch for testing. Affects `mw_check_known_conflicts`
# for Bethesda games only.
# LOOT_BRANCH=
