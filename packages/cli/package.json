{
  "name": "@modwrench/cli",
  "version": "0.2.4",
  "mcpName": "io.github.171county/modwrench",
  "description": "ModWrench \u2014 one MCP entry, every mod platform. Bundles all installed @modwrench/* platform packages into a single combined MCP server.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modding",
    "nexus-mods",
    "modio",
    "thunderstore",
    "skyrim",
    "crash-analysis",
    "load-order",
    "steam-deck",
    "ai-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/171county/modwrench.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/171county/modwrench#readme",
  "bugs": {
    "url": "https://github.com/171county/modwrench/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "modwrench": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@modwrench/core": "0.2.4",
    "@modwrench/modio": "0.2.4",
    "@modwrench/nexus": "0.2.4",
    "@modwrench/thunderstore": "0.2.4",
    "@modwrench/ui": "0.2.4",
    "@modwrench/workbench": "0.2.4",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
