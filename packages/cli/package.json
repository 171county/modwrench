{
  "name": "@modwrench/cli",
  "version": "0.0.1",
  "mcpName": "io.github.171county/modwrench",
  "description": "ModWrench — one MCP entry, every mod platform. Bundles all installed @modwrench/* platform packages into a single combined MCP server.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/171county/modwrench.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/171county/modwrench#readme",
  "bugs": {
    "url": "https://github.com/171county/modwrench/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "modwrench": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@mcpwrench/core": "0.0.1",
    "@modwrench/modio": "0.0.1",
    "@modwrench/modrinth": "0.0.1",
    "@modwrench/nexus": "0.0.1",
    "@modwrench/thunderstore": "0.0.1",
    "@modwrench/workbench": "0.0.1",
    "@modelcontextprotocol/sdk": "^1.0.4"
  }
}
