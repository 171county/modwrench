{
    "name":  "@modwrench/thunderstore",
    "version":  "0.1.0",
    "description":  "ModWrench â€” Thunderstore MCP server. Discover and inspect mods on Thunderstore (Lethal Company, Valheim, R.E.P.O., Risk of Rain 2, Dyson Sphere Program, BONEWORKS, and other Unity co-op games) directly from any MCP-compatible AI client.",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/171county/modwrench.git",
                       "directory":  "packages/thunderstore"
                   },
    "homepage":  "https://github.com/171county/modwrench#readme",
    "bugs":  {
                 "url":  "https://github.com/171county/modwrench/issues"
             },
    "type":  "module",
    "main":  "./dist/index.js",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          },
                    "./register":  {
                                       "types":  "./dist/register.d.ts",
                                       "import":  "./dist/register.js"
                                   }
                },
    "bin":  {
                "modwrench-thunderstore":  "dist/index.js"
            },
    "files":  [
                  "dist"
              ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsc",
                    "dev":  "tsx watch src/index.ts",
                    "start":  "node dist/index.js",
                    "clean":  "rimraf dist",
                    "typecheck":  "tsc --noEmit",
                    "test":  "node --import tsx --test test/*.test.ts"
                },
    "dependencies":  {
                         "@modwrench/core":  "0.1.0",
                         "@modelcontextprotocol/sdk":  "^1.0.4",
                         "zod":  "^3.23.8"
                     }
}
