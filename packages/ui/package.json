{
  "name": "@modwrench/ui",
  "version": "0.2.4",
  "description": "ModWrench \u2014 the MCP Apps pages for ModWrench tools (mod lists, dependencies and load order, crash logs, conflicts, the deck, Patch Day, Crash Whisperer, the Doctor), served as ui:// resources that clients which support MCP Apps fetch and draw. Four flagship-game skins (Skyrim, Fallout, Lethal Company, Valheim). Holds no state; no page makes a network request.",
  "keywords": [
    "mcp",
    "mcp-apps",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/171county/modwrench.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/171county/modwrench#readme",
  "bugs": {
    "url": "https://github.com/171county/modwrench/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modwrench/core": "0.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
