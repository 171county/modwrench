{
  "name": "@modwrench/ui",
  "version": "0.2.0",
  "description": "ModWrench — stateless MCP-UI toolkit. Themed interactive UI (mod deck, mod cards, crashlog panel) returned as ui:// resources from ModWrench tools, with four flagship-game themes (Skyrim, Fallout, Lethal Company, Valheim). Holds no state; every view is rendered fresh from a tool result.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/171county/modwrench.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/171county/modwrench#readme",
  "bugs": {
    "url": "https://github.com/171county/modwrench/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modwrench/core": "0.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
