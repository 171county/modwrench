{
  "name": "@modwrench/remote",
  "version": "0.2.0",
  "description": "ModWrench remote Streamable HTTP MCP server for remote-capable clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/171county/modwrench.git",
    "directory": "packages/remote"
  },
  "homepage": "https://github.com/171county/modwrench#readme",
  "bugs": {
    "url": "https://github.com/171county/modwrench/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "modwrench-remote": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@modwrench/core": "0.2.0",
    "@modwrench/thunderstore": "0.2.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
