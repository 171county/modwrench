{
    "name":  "@modwrench/workbench",
    "version":  "0.1.0",
    "description":  "ModWrench â€” the modder workbench. Atomic MCP tools for environment detection, load-order parsing, crashlog analysis, and known-conflict lookups.",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/171county/modwrench.git",
                       "directory":  "packages/workbench"
                   },
    "homepage":  "https://github.com/171county/modwrench#readme",
    "bugs":  {
                 "url":  "https://github.com/171county/modwrench/issues"
             },
    "type":  "module",
    "main":  "./dist/index.js",
    "exports":  {
                    ".":  {
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          },
                    "./register":  {
                                       "types":  "./dist/register.d.ts",
                                       "import":  "./dist/register.js"
                                   },
                    "./detect":  {
                                     "types":  "./dist/detect/environment.d.ts",
                                     "import":  "./dist/detect/environment.js"
                                 }
                },
    "bin":  {
                "modwrench-workbench":  "dist/index.js"
            },
    "files":  [
                  "dist",
                  "data"
              ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsc",
                    "dev":  "tsx watch src/index.ts",
                    "start":  "node dist/index.js",
                    "clean":  "rimraf dist",
                    "typecheck":  "tsc --noEmit",
                    "test":  "node --import tsx --test test/*.test.ts"
                },
    "dependencies":  {
                         "@modwrench/core":  "0.1.0",
                         "@modelcontextprotocol/sdk":  "^1.0.4",
                         "js-yaml":  "^4.1.0",
                         "zod":  "^3.23.8"
                     },
    "devDependencies":  {
                            "@types/js-yaml":  "^4.0.9"
                        }
}
