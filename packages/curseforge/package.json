{
  "name": "@modwrench/curseforge",
  "version": "0.0.1",
  "description": "ModWrench — CurseForge MCP server. Search, browse, and inspect mods on CurseForge directly from any MCP-compatible AI client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/171county/modwrench.git",
    "directory": "packages/curseforge"
  },
  "homepage": "https://github.com/171county/modwrench#readme",
  "bugs": {
    "url": "https://github.com/171county/modwrench/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "bin": {
    "modwrench-curseforge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modwrench/core": "0.0.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  }
}
