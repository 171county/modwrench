{
  "name": "modwrench",
  "version": "0.2.2",
  "private": true,
  "description": "ModWrench — an MCP toolkit for modders.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/171county/modwrench.git"
  },
  "homepage": "https://github.com/171county/modwrench#readme",
  "bugs": {
    "url": "https://github.com/171county/modwrench/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/ui",
    "packages/nexus",
    "packages/modio",
    "packages/thunderstore",
    "packages/workbench",
    "packages/remote",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:publishable": "node scripts/check-publishable.mjs",
    "check:release": "node scripts/check-publishable.mjs --registry"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
